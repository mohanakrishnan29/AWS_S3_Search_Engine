# ========================================
# Flask Configuration
# ========================================
SECRET_KEY=your-secret-key-change-in-production
FLASK_ENV=development
FLASK_DEBUG=True

# ========================================
# AWS S3 Configuration
# ========================================
AWS_S3_BUCKET=samsung-prism-logs
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# S3 Prefix (optional - filter objects by prefix, e.g., 'log_2021')
S3_PREFIX=

# Optional: Custom S3 endpoint (for S3 Ninja, MinIO, etc.)
# S3_ENDPOINT_URL=http://localhost:9000
S3_ENDPOINT_URL=

# ========================================
# Performance Optimization (RECOMMENDED FOR 3M+ FILES)
# ========================================

# 🚀 OPTIMIZATION: Use standard service (better for 3M files)
# The async version has overhead - standard is faster for large datasets
USE_OPTIMIZED_SERVICE=False

# Parallel workers for S3 operations
# Standard: 30 workers works best for 3M files
S3_MAX_WORKERS=30

# HTTP connection pool size
# Standard: 100 connections
S3_MAX_POOL_CONNECTIONS=100

# ========================================
# S3 Inventory (FASTEST - 2-4 MIN FOR 3M FILES)
# ========================================

# Enable S3 Inventory for ultra-fast initial indexing
# Cost: ~$0.75/month for 3M files
# Requires setup in AWS Console (24-48 hour wait for first inventory)
USE_S3_INVENTORY=False

# Path to downloaded S3 Inventory file (Parquet or CSV)
# Uncomment and set path after downloading inventory file
# S3_INVENTORY_FILE_PATH=./inventory.parquet

# ========================================
# SQLite Index (RECOMMENDED - 100X FASTER QUERIES)
# ========================================

# ✅ Use SQLite instead of JSON for faster LOCAL queries
# TRUE CLIENT-SIDE SEARCH: All queries run on Flask server (no network calls)
# Recommended for 3M+ files with heavy query workload
USE_SQLITE_INDEX=True

# SQLite database file path
SQLITE_DB_FILE=s3_index.db

# ========================================
# Real-Time Event-Driven Updates (NEW!)
# ========================================

# ✅ Enable automatic index updates when objects are uploaded/deleted
# Uses: S3 ObjectCreated/Removed → SQS → Worker → SQLite
# Requires: SQS queue configured to receive S3 events
ENABLE_EVENT_DRIVEN_UPDATES=False

# SQS queue URL (get from AWS Console after setup)
# Example: https://sqs.us-east-1.amazonaws.com/123456789012/s3-events-queue-prism-YYYYMMDDHHMMSS
SQS_QUEUE_URL=

# SQS polling configuration
SQS_POLL_INTERVAL=5          # Seconds between polls (default: 5)
SQS_MAX_MESSAGES=10          # Max messages per poll (1-10)
SQS_WAIT_TIME=20             # Long polling wait (0-20 seconds, recommended: 20)
SQS_VISIBILITY_TIMEOUT=30    # Message processing timeout (seconds)

# ========================================
# Smart Refresh Settings
# ========================================

# Enable smart/incremental refresh
ENABLE_SMART_REFRESH=True
INCREMENTAL_REFRESH_ENABLED=True

# Force full scan after this interval (seconds)
# Default: 86400 = 24 hours
FULL_SCAN_INTERVAL=86400

# Detect deleted objects during incremental refresh
ENABLE_DELETION_DETECTION=True

# Max age for incremental refresh (seconds)
MAX_INCREMENTAL_AGE=300

# ========================================
# Local Storage Settings
# ========================================
DATASET_DIR=mock_s3_bucket
INDEX_FILE=s3_index.json

# Index Cache Timeout (seconds)
INDEX_CACHE_TIMEOUT=300

# Use Mock Data (True) or AWS S3 (False)
USE_MOCK_DATA=False

# Local workers for indexing mock data
LOCAL_INDEX_WORKERS=20

# ========================================
# Upload Configuration
# ========================================
UPLOAD_TO_AWS=True

# ========================================
# Pagination & Export Settings
# ========================================
RESULTS_PER_PAGE=1000
EXPORT_MAX_ROWS=10000
